# LunarSynapse Environment Configuration

PROJECT_NAME=LunarSynapse
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/lunarsynapse.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]

# Hardware & Acceleration
