# ==============================================================================
# LunarSynapse Environment Configuration (.env.example)
# Physics-Aware, Self-Evolving Multi-Modal Lunar World Model (SIH26166)
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or private tokens.
# Use these environment variables to configure local development and validation.
# ==============================================================================

# --- System & API Settings ---
PROJECT_NAME=LunarSynapse
VERSION=8.7.0
API_PREFIX=/api
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Configuration ---
# SQLite local file or PostgreSQL connection URI
DATABASE_URL=sqlite:///./outgraph/data/lunarsynapse.db

# --- CORS Allowed Origins ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8000

# --- Scientific Worker & Resource Directories ---
# Base directories for cached rasters, GroundGrids, and local images
DATA_DIR=./data
IMAGES_DIR=./outgraph/data/storage/images
CACHE_DIR=./data/cache

# --- Large-Data Read-Only Volume Boundary ---
# Path to external or local real lunar PDS4 products (multi-GB block storage)
# NOTE: Raw binaries must NEVER be copied into serverless or web bundles.
REAL_LUNAR_DATA_PATH=./data/real

# --- Topographic Reference Model (DEM) ---
SLDEM2015_PATH=./data/real/ch2_tmc_ncn_20200318t1349141011_d_img_d18.img
DEM_ELEVATION_MIN_M=-9000
DEM_ELEVATION_MAX_M=11000

# --- Computational & ML Acceleration ---
USE_GPU=false
TORCH_DEVICE=cpu
RANSAC_REPROJECTION_THRESHOLD_PX=3.5
ENABLE_SUBPIXEL_ECC=true
NUM_WORKER_THREADS=4
